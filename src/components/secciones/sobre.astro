---
// «Quiénes somos»: mitad foto a sangre (a la izquierda, `imagen`) y mitad texto: titular, «Desde» con el año en cifra
// de estilo antiguo muy grande (`desde`), la `declaracion` en Vollkorn, el texto en párrafos y los `items` como valores
// en filas con filetes. Sin `imagen`, el texto va en el contenedor. Sin `desde`, no hay cifra.
import { seccion, parrafos } from '../../data/site';
import { altSeccion } from '../../lib/seo';
import Titular from '../ui/Titular.astro';
import Imagen from '../ui/Imagen.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
const desde = String(s?.desde ?? '').trim();
const declaracion = String(s?.declaracion ?? '').trim();
---

{
  s && (s.titulo || s.texto || s.imagen || desde || declaracion || s.items.length > 0) && (
    <section id={Astro.props.id} class:list={['banda', 'banda--papel', { 'banda--sin-relleno': s.imagen }]}>
      <div class:list={[s.imagen ? 'mitades mitades--foto-izq' : 'contenedor']}>
        <div class:list={{ 'mitad-texto': s.imagen }}>
          <Titular antetitulo={s.antetitulo} titulo={s.titulo} />
          {desde && (
            <p class="desde">
              <span class="menuda">Desde</span>
              <span class="desde-cifra">{desde}</span>
            </p>
          )}
          {declaracion && <p class="declaracion">{declaracion}</p>}
          {parrafos(s.texto).length > 0 && <div class="parrafos">{parrafos(s.texto).map((p) => <p>{p}</p>)}</div>}
          {s.items.length > 0 && (
            <ul class="valores">
              {s.items.map((it) => (
                <li>
                  <p class="valores-titulo">{it.titulo}</p>
                  {it.texto && <p class="valores-texto">{it.texto}</p>}
                </li>
              ))}
            </ul>
          )}
        </div>
        {s.imagen && (
          <div class="mitad-foto foto">
            <Imagen src={s.imagen} alt={altSeccion(s)} ancho={1300} alto={1300} />
          </div>
        )}
      </div>
    </section>
  )
}
